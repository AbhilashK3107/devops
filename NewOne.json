{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "A simple CloudFormation template to create an Amazon RDS MySQL DB Instance.",
  "Parameters": {
    "DBInstanceIdentifier": {
      "Type": "String",
      "Description": "The DB instance identifier.",
      "Default": "my-mysql-instance"
    },
    "DBAllocatedStorage": {
      "Type": "Number",
      "Description": "The size of the database (in GiB).",
      "Default": "20"
    },
    "DBInstanceClass": {
      "Type": "String",
      "Description": "The DB instance class.",
      "Default": "db.t3.micro"
    },
    "DBEngine": {
      "Type": "String",
      "Description": "The database engine.",
      "Default": "mysql"
    },
    "DBEngineVersion": {
      "Type": "String",
      "Description": "The database engine version.",
      "Default": "8.0.33"
    },
    "DBMasterUsername": {
      "Type": "String",
      "Description": "The master username for the database.",
      "Default": "admin"
    },
    "DBMasterUserPassword": {
      "Type": "String",
      "Description": "The master password for the database.",
      "NoEcho": true
    },
    "DBSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup::Id",
      "Description": "The ID of the security group to associate with the DB instance."
    }
  },
  "Resources": {
    "MyDBInstance": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "DBInstanceIdentifier": { "Ref": "DBInstanceIdentifier" },
        "AllocatedStorage": { "Ref": "DBAllocatedStorage" },
        "DBInstanceClass": { "Ref": "DBInstanceClass" },
        "Engine": { "Ref": "DBEngine" },
        "EngineVersion": { "Ref": "DBEngineVersion" },
        "MasterUsername": { "Ref": "DBMasterUsername" },
        "MasterUserPassword": { "Ref": "DBMasterUserPassword" },
        "VPCSecurityGroups": [ { "Ref": "DBSecurityGroup" } ],
        "MultiAZ": "false",
        "BackupRetentionPeriod": "7",
        "PreferredBackupWindow": "03:00-05:00",
        "PreferredMaintenanceWindow": "sun:06:00-sun:07:00",
        "PubliclyAccessible": "false"
      }
    }
  },
  "Outputs": {
    "DBEndpointAddress": {
      "Description": "The endpoint address of the RDS DB Instance.",
      "Value": { "Fn::GetAtt": [ "MyDBInstance", "Endpoint.Address" ] }
    },
    "DBEndpointPort": {
      "Description": "The endpoint port of the RDS DB Instance.",
      "Value": { "Fn::GetAtt": [ "MyDBInstance", "Endpoint.Port" ] }
    }
  }
}